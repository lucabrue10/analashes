# Unsere Startseite hat Vorrang, auch wenn im Ordner noch Reste einer
# alten Installation liegen.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Schriften und Bilder dürfen lange im Zwischenspeicher bleiben,
# HTML-Dateien nicht – sonst sehen Besucher nach einer Änderung
# noch tagelang den alten Stand.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
